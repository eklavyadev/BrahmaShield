{
  "name": "brahmashield",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:smoke": "node tests/http-smoke.mjs",
    "test:cloud": "node --env-file=.env.local --import tsx tests/cloud-smoke.ts",
    "test:cloud-auth": "node --env-file=.env.local tests/cloud-auth-smoke.mjs",
    "test:on-site": "node tests/on-site-smoke.mjs",
    "check:backend": "node --env-file=.env.local --import tsx scripts/check-backend.ts",
    "check:gemma": "node --env-file=.env.local --import tsx scripts/check-gemma.ts",
    "worker": "node --env-file=.env.local --import tsx scripts/worker.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.15",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
