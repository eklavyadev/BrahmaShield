# Local durable SQLite storage. Use a persistent disk, one app instance.
DATA_DIRECTORY=.data
# Demo uses a clearly labelled local operator sign-in. Set both for deployment.
RESPONDER_PASSWORD=
SESSION_SECRET=
# OpenAI-compatible serving endpoint hosting actual Gemma weights.
AI_MODE=demo
GEMMA_BASE_URL=http://localhost:11434/v1
GEMMA_MODEL=gemma3:4b
GEMMA_API_KEY=
# Official alert adapters are demo-only until approved source access is configured.
