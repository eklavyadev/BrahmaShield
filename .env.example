# Local durable SQLite storage. Use a persistent disk, one app instance.
DATA_DIRECTORY=.data
# Set supabase to use cloud persistence and individual responder accounts.
BACKEND=sqlite
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
# Cloud starts empty by default. This only controls first-time initialization.
SEED_DEMO_DATA=false
# Demo uses a clearly labelled local operator sign-in. Set both for deployment.
RESPONDER_PASSWORD=
SESSION_SECRET=
# OpenAI-compatible serving endpoint hosting actual Gemma weights.
AI_MODE=demo
GEMMA_BASE_URL=http://localhost:11434/v1
GEMMA_MODEL=gemma3:4b
GEMMA_API_KEY=
GEMMA_TIMEOUT_MS=180000
# Official alert adapters are demo-only until approved source access is configured.
